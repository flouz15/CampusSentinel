DB_ENGINE=django.db.backends.mysql
DB_NAME=campus_security
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_HOST_USER=your_email@qq.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_SSL=True
EMAIL_SENDER=your_email@qq.com

# 检测服务（与前端 window.PORTAL_DETECTION_BASE 一致）
DETECTION_BASE_URL=http://127.0.0.1:8001
ALERT_API_BASE_URL=http://127.0.0.1:8080

# 高德 Web 服务 Key，仅供后端代理地理编码、天气、POI 等接口使用
AMAP_WEB_SERVICE_KEY=

# 大屏请求后端时使用的密钥，需要与 config/dashboard.json 的 dashboardApiKey 一致
DASHBOARD_API_KEY=

# 机器人向后端上报状态时使用的密钥；留空时仅接受本机或已通过大屏密钥校验的请求
ROBOT_INGEST_KEY=

# 安保巡检原始画面：海康等 RTSP 子码流（勿提交含真实密码的 .env；前端通过 /api/patrol/camera-mjpeg 拉流）
# PATROL_RAW_CAMERA_RTSP_URL=rtsp://user:pass@192.168.1.64:554/Streaming/Channels/102

# =========================
# 智能巡检助手 · DeepSeek
# =========================
# 兼容模式接口地址（OpenAI Chat Completions 风格）
DEEPSEEK_COMPAT_BASE_URL=https://api.deepseek.com/v1
# DeepSeek API Key（sk-...；不要提交真实 Key）
DEEPSEEK_API_KEY=
# 首页智能巡检助手默认模型（不开启思考/推理）
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek 请求超时时间（秒）
DEEPSEEK_TIMEOUT_SECONDS=60

# =========================
# 智能巡检助手 · 本地回退
# =========================
# 本地 Ollama 服务地址；DeepSeek 不可用时尝试调用
ASSISTANT_OLLAMA_BASE=http://127.0.0.1:11434
# 本地 Ollama 模型名
ASSISTANT_OLLAMA_MODEL=qwen2.5:7b-instruct
# LightRAG 服务地址；可用于知识库问答
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
# LightRAG API Key；服务未开启鉴权时可留空
LIGHTRAG_API_KEY=
# LightRAG 请求超时时间（秒）
LIGHTRAG_TIMEOUT_SECONDS=120
